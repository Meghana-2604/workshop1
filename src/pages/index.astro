---
import Layout from '../layouts/Layout.astro';
import GameCard from '../components/GameCard.astro';
import PageHero from '../components/PageHero.astro';
import EmptyState from '../components/EmptyState.astro';
import { getDatabase } from '../lib/db';
import { getAllGames } from '../lib/games';

export const prerender = true;

const pageSize = 12;
const games = await getAllGames(getDatabase());
const totalPages = Math.ceil(games.length / pageSize);
const categories = [...new Map(
  games
    .filter((game) => game.category)
    .map((game) => [game.category!.id, game.category!]),
).values()].sort((a, b) => a.name.localeCompare(b.name));
const publishers = [...new Map(
  games
    .filter((game) => game.publisher)
    .map((game) => [game.publisher!.id, game.publisher!]),
).values()].sort((a, b) => a.name.localeCompare(b.name));
---

<Layout title="Tailspin Toys - Crowdfunding your new favorite game!">
  <div class="py-8">
    <PageHero
      title="Welcome to Tailspin Toys"
      subtitle="Find your next game! And maybe even back one! Explore our collection!"
    />

    <div>
      <h2 class="text-2xl font-medium mb-6 text-slate-100">Featured Games</h2>

      {games.length === 0 ? (
        <EmptyState text="No games available at the moment." />
      ) : (
        <>
          <form
            class="mb-8 rounded-xl border border-slate-700 bg-slate-800/60 p-6"
            data-testid="game-filters"
            aria-label="Filter games"
          >
            <div class="grid gap-6 md:grid-cols-[2fr_1fr_2fr_auto]">
              <div>
                <label for="game-search" class="mb-3 block text-sm font-medium text-slate-200">
                  Search by title
                </label>
                <input
                  id="game-search"
                  type="search"
                  name="search"
                  placeholder="Search games..."
                  autocomplete="off"
                  class="w-full rounded-lg border border-slate-600 bg-slate-900 px-3 py-2 text-slate-100 placeholder:text-slate-400 focus:ring-2 focus:ring-blue-500 focus:outline-none"
                  data-testid="game-search"
                />
              </div>

              <fieldset>
                <legend class="mb-3 text-sm font-medium text-slate-200">Categories</legend>
                <div class="flex flex-wrap gap-3">
                  {categories.map((category) => (
                    <label class="inline-flex items-center gap-2 text-sm text-slate-300">
                      <input
                        type="checkbox"
                        name="category"
                        value={category.id}
                        class="h-4 w-4 rounded border-slate-600 bg-slate-900 text-blue-500 focus:ring-2 focus:ring-blue-500"
                        data-testid={`category-filter-${category.id}`}
                      />
                      <span>{category.name}</span>
                    </label>
                  ))}
                </div>
              </fieldset>

              <div>
                <label for="publisher-filter" class="mb-3 block text-sm font-medium text-slate-200">
                  Publisher
                </label>
                <select
                  id="publisher-filter"
                  name="publisher"
                  class="w-full rounded-lg border border-slate-600 bg-slate-900 px-3 py-2 text-slate-100 focus:ring-2 focus:ring-blue-500 focus:outline-none"
                  data-testid="publisher-filter"
                >
                  <option value="">All publishers</option>
                  {publishers.map((publisher) => (
                    <option value={publisher.id}>{publisher.name}</option>
                  ))}
                </select>
              </div>

              <button
                type="reset"
                class="self-end rounded-lg border border-slate-600 px-4 py-2 text-sm font-medium text-slate-200 transition-colors hover:bg-slate-700 focus:ring-2 focus:ring-blue-500 focus:outline-none"
                data-testid="clear-filters"
              >
                Clear filters
              </button>
            </div>
            <p class="mt-4 text-sm text-slate-400" data-testid="filter-results" role="status" aria-live="polite"></p>
          </form>

          <div class="grid grid-cols-1 gap-6 sm:grid-cols-2 lg:grid-cols-3" data-testid="games-grid">
          {games.map((game) => <GameCard game={game} />)}
          </div>
          <p class="hidden py-8 text-center text-slate-300" data-testid="no-filter-results" role="status">
            No games match the selected filters.
          </p>
          <nav
            class="mt-8 flex flex-wrap items-center justify-center gap-2"
            aria-label="Game list pagination"
            data-testid="game-pagination"
            data-page-size={pageSize}
            data-total-pages={totalPages}
          >
            <button
              type="button"
              class="rounded-lg border border-slate-600 px-4 py-2 text-sm font-medium text-slate-200 transition-colors hover:bg-slate-700 focus:ring-2 focus:ring-blue-500 focus:outline-none disabled:cursor-not-allowed disabled:opacity-50"
              data-testid="pagination-previous"
              aria-label="Previous page"
            >
              Previous
            </button>
            <span class="text-sm text-slate-300" data-testid="pagination-status" aria-live="polite"></span>
            <button
              type="button"
              class="rounded-lg border border-slate-600 px-4 py-2 text-sm font-medium text-slate-200 transition-colors hover:bg-slate-700 focus:ring-2 focus:ring-blue-500 focus:outline-none disabled:cursor-not-allowed disabled:opacity-50"
              data-testid="pagination-next"
              aria-label="Next page"
            >
              Next
            </button>
          </nav>
        </>
      )}
    </div>
  </div>
</Layout>

<script>
  const filterForm = document.querySelector<HTMLFormElement>('[data-testid="game-filters"]');
  const gameCards = [...document.querySelectorAll<HTMLElement>('[data-testid="game-card"]')];
  const resultStatus = document.querySelector<HTMLElement>('[data-testid="filter-results"]');
  const noResults = document.querySelector<HTMLElement>('[data-testid="no-filter-results"]');
  const pagination = document.querySelector<HTMLElement>('[data-testid="game-pagination"]');

  if (filterForm && resultStatus && noResults && pagination) {
    const categoryInputs = [...filterForm.querySelectorAll<HTMLInputElement>('input[name="category"]')];
    const publisherInput = filterForm.querySelector<HTMLSelectElement>('select[name="publisher"]');
    const searchInput = filterForm.querySelector<HTMLInputElement>('input[name="search"]');
    const previousButton = pagination.querySelector<HTMLButtonElement>('[data-testid="pagination-previous"]');
    const nextButton = pagination.querySelector<HTMLButtonElement>('[data-testid="pagination-next"]');
    const paginationStatus = pagination.querySelector<HTMLElement>('[data-testid="pagination-status"]');
    const pageSize = Number(pagination.dataset.pageSize);

    const applyFilters = (updateUrl = true, resetPage = false) => {
      const selectedCategories = categoryInputs
        .filter((input) => input.checked)
        .map((input) => input.value);
      const selectedPublisher = publisherInput?.value ?? '';
      const searchTerm = searchInput?.value.trim().toLocaleLowerCase() ?? '';
      const matchingCards = gameCards.filter((card) => {
        const categoryMatches =
          selectedCategories.length === 0 ||
          selectedCategories.includes(card.dataset.categoryId ?? '');
        const publisherMatches =
          selectedPublisher === '' || selectedPublisher === card.dataset.publisherId;
        const titleMatches = (card.dataset.gameTitle ?? '').toLocaleLowerCase().includes(searchTerm);
        return categoryMatches && publisherMatches && titleMatches;
      });
      const totalPages = Math.max(1, Math.ceil(matchingCards.length / pageSize));
      const params = new URLSearchParams(window.location.search);
      const requestedPage = resetPage ? 1 : Number(params.get('page') ?? 1);
      const currentPage = Math.min(Math.max(1, Number.isFinite(requestedPage) ? requestedPage : 1), totalPages);
      const pageStart = (currentPage - 1) * pageSize;
      const pageCards = new Set(matchingCards.slice(pageStart, pageStart + pageSize));
      gameCards.forEach((card) => {
        card.hidden = !pageCards.has(card);
      });

      resultStatus.textContent = `${matchingCards.length} ${matchingCards.length === 1 ? 'game' : 'games'} shown`;
      noResults.classList.toggle('hidden', matchingCards.length > 0);
      if (paginationStatus && previousButton && nextButton) {
        paginationStatus.textContent = `Page ${currentPage} of ${totalPages}`;
        previousButton.disabled = currentPage === 1;
        nextButton.disabled = currentPage === totalPages;
        pagination.hidden = matchingCards.length === 0;
      }

      if (updateUrl) {
        const nextParams = new URLSearchParams();
        selectedCategories.forEach((category) => nextParams.append('category', category));
        if (selectedPublisher) {
          nextParams.set('publisher', selectedPublisher);
        }
        if (searchTerm) {
          nextParams.set('search', searchTerm);
        }
        if (currentPage > 1) {
          nextParams.set('page', String(currentPage));
        }
        const query = nextParams.toString();
        window.history.replaceState({}, '', query ? `/?${query}` : '/');
      }
    };

    const params = new URLSearchParams(window.location.search);
    const selectedCategories = new Set(params.getAll('category'));
    categoryInputs.forEach((input) => {
      input.checked = selectedCategories.has(input.value);
    });
    if (publisherInput) {
      publisherInput.value = params.get('publisher') ?? '';
    }
    if (searchInput) {
      searchInput.value = params.get('search') ?? '';
    }

    filterForm.addEventListener('change', () => applyFilters(true, true));
    searchInput?.addEventListener('input', () => applyFilters(true, true));
    filterForm.addEventListener('submit', (event) => {
      event.preventDefault();
      applyFilters();
    });
    filterForm.addEventListener('reset', () => {
      requestAnimationFrame(() => applyFilters(true, true));
    });
    previousButton?.addEventListener('click', () => {
      const currentPage = Number(new URLSearchParams(window.location.search).get('page') ?? 1);
      const previousPage = Math.max(1, currentPage - 1);
      const params = new URLSearchParams(window.location.search);
      if (previousPage === 1) {
        params.delete('page');
      } else {
        params.set('page', String(previousPage));
      }
      window.history.replaceState({}, '', params.toString() ? `/?${params}` : '/');
      applyFilters(false);
    });
    nextButton?.addEventListener('click', () => {
      const currentPage = Number(new URLSearchParams(window.location.search).get('page') ?? 1);
      const nextPage = currentPage + 1;
      const params = new URLSearchParams(window.location.search);
      params.set('page', String(nextPage));
      window.history.replaceState({}, '', `/?${params}`);
      applyFilters(false);
    });
    applyFilters(false);
  }
</script>
